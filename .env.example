# ==============================================================================
# COCKROACH MUTUAL AID BOARD - ENVIRONMENT CONFIGURATION TEMPLATE
# Copy this file to .env before starting the server. DO NOT COMMIT REAL SECRETS.
# ==============================================================================

# Node Environment ('development' | 'production' | 'test')
NODE_ENV=production

# Backend Server Listening Port
PORT=5000

# PostgreSQL Database Connection String (Primary for Cloud Deployments)
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?sslmode=require
DATABASE_URL=postgresql://postgres:password@localhost:5432/mutual_aid

# SQLite Database Storage Fallback (Used when DATABASE_URL is omitted)
DB_PATH=./mutual_aid.db

# Cryptographically Secure JWT Secret Key (64-byte random hex)
# Generate via: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=c8f5e927b1a4d3e6f98721c0b3d4e5f6a7b8c9d0e1f2a3b4c5d6e7f8a9b0c1d2e3f4a5b6c7d8e9f0a1b2c3d4e5f6a7b8

# AES-256 Location Encryption Secret Key (32-character hex key)
AES_SECRET_KEY=9f8e7d6c5b4a3f2e1d0c9b8a7f6e5d4c3b2a1f0e9d8c7b6a5f4e3d2c1b0a9f8e

# Twilio SMS Gateway Credentials (Live Mobile SMS OTP Dispatch)
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_twilio_auth_token_here
TWILIO_PHONE_NUMBER=+18285323474

# Email Gateway Configuration (Nodemailer HTML Email OTP Dispatch)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password_here

GMAIL_USER=cockroachaid.otp@gmail.com
GMAIL_APP_PASS=your_gmail_app_pass_here

# Frontend Application CORS Allowed Origins (comma separated)
CORS_ORIGIN=https://cockroach-mutual-aid.vercel.app,http://localhost:3000
